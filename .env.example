# Backend
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Docker: postgresql+psycopg://enrichment:enrichment@localhost:5432/enrichment
# Local without Docker (API + /predict only; Celery needs Redis):
DATABASE_URL=sqlite:///./enrichment.db
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
CORS_ORIGINS=["http://localhost:3000"]
DEBUG=false
INTELLIGENCE_SYNC_FALLBACK=true

# Frontend (Next.js API routes)
OPENAI_API_KEY=
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# OSINT collectors (optional)
NEWSAPI_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENSANCTIONS_API_KEY=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
OPENCORPORATES_API_KEY=
